# ============================================================================
# Keel — Bootstrap Container Environment (.env.example)
# ============================================================================
# All trading, risk, AI budget, and notification parameters live in the
# versioned SQLite Config Registry and are adjusted in the Keel web UI.
# Only container-level bootstrap settings belong in environment variables.

# HTTP port inside the container (serves both Fastify API and React Web UI)
PORT=8080
HOST=0.0.0.0

# Persistent Unraid mount paths inside the container
DATA_DIR=/data
BACKUPS_DIR=/backups

# Unraid user/group permissions (nobody:users = 99:100 on Unraid)
PUID=99
PGID=100
UMASK=022

# Structured Pino log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info
NODE_ENV=production

