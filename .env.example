# ============================================================================
# Keel — container settings (.env beside docker-compose.yml)
# ============================================================================
# Trading, risk, AI budgets, notifications and the Fleet's duties live in Keel's
# versioned config and are changed in the Engine Room. Only container-level
# settings belong here.

# Required: the vault master key (at least 32 characters, 12 distinct).
# Generate with: openssl rand -base64 48 — and keep it in your password manager.
KEEL_MASTER_KEY=

# The host port Keel is reached on (inside the container it is always 8080)
KEEL_PORT=8080

# Sign in over plain http://<server-ip>:<port> on your LAN. HTTPS still gets
# Secure cookies. Set false if Keel is only ever reached over HTTPS.
KEEL_ALLOW_INSECURE_HTTP=true

# Fetch new hourly bars and step the Fleet; without it boats never trade
KEEL_ENABLE_SCHEDULER=true

# Optional: lets Claude design boats in the Shipyard (or store it in the vault)
ANTHROPIC_API_KEY=
